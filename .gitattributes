# Normalização de fim de linha
* text=auto

# Reconhecimento de linguagem no GitHub (Linguist) — consistente com os
# demais repositórios (a doc não contém arquivos .cryo/.pyro; aqui só por
# consistência de convenção).
*.cryo linguist-language=Rust
*.pyro binary

# The playground's WebAssembly engine. `* text=auto` above would treat these
# as text and rewrite their line endings, which corrupts a .wasm silently —
# it still downloads, and then fails to instantiate in the browser.
*.wasm binary
